@model IEnumerable<SecureMedicalTransfer.Models.AccessLog>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-warning">NHẬT KÝ HỆ THỐNG (AUDIT LOGS)</h2>
        <a href="/Medical/Index" class="btn btn-secondary btn-sm">Quay lại</a>
    </div>
    <p class="text-muted">Trang báo cáo lịch sử dành riêng cho Auditor để kiểm soát rủi ro an toàn thông tin.</p>

    <table class="table table-hover table-bordered table-dark shadow">
        <thead>
            <tr>
                <th>Thời gian</th>
                <th>Tài khoản</th>
                <th>Hành động</th>
                <th>Trạng thái bảo mật</th>
                <th>Chi tiết kỹ thuật</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr class="@(log.Status == "Thất bại" || log.Action.Contains("Kiểm thử") ? "table-danger text-dark" : "")">
                    <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td><strong>@log.Username</strong></td>
                    <td>@log.Action</td>
                    <td>
                        <span class="badge @(log.Status == "Thành công" || log.Status.Contains("Thành công") ? "bg-success" : "bg-danger")">
                            @log.Status
                        </span>
                    </td>
                    <td><small>@log.Details</small></td>
                </tr>
            }
        </tbody>
    </table>
</div>