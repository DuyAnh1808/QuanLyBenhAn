@model IEnumerable<SecureMedicalTransfer.Models.MedicalRecord>

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    body {
        font-family: 'Plus Jakarta Sans', sans-serif !important;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%) !important;
        color: #1e293b;
        min-height: 100vh;
    }

    h2, h4, h5 {
        font-weight: 700 !important;
        color: #0f172a;
    }

    .container {
        max-width: 1240px;
    }

        .card, .container > div.card {
            background: #ffffff !important;
            border: 1px solid rgba(226, 232, 240, 0.8) !important;
            border-radius: 20px !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02), 0 10px 15px -3px rgba(0, 0, 0, 0.03) !important;
            padding: 32px !important;
            margin-bottom: 30px !important;
            transition: all 0.3s ease;
        }

    .form-control {
        border-radius: 12px !important;
        border: 1.5px solid #cbd5e1 !important;
        padding: 14px 18px !important;
        font-size: 0.95rem;
        background-color: #f8fafc;
        color: #334155;
        transition: all 0.2s ease;
    }

        .form-control:focus {
            background-color: #fff;
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12) !important;
        }

    .btn {
        border-radius: 12px !important;
        font-weight: 600 !important;
        padding: 12px 24px !important;
        font-size: 0.95rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06) !important;
        }

        .btn:active {
            transform: translateY(0) !important;
        }

    .btn-sm {
        padding: 8px 16px !important;
        font-size: 0.85rem !important;
        border-radius: 10px !important;
    }

    .btn-primary {
        background-color: #2563eb !important;
        border: none !important;
    }

    .btn-success {
        background-color: #10b981 !important;
        border: none !important;
    }

    .btn-warning {
        background-color: #f59e0b !important;
        color: #fff !important;
        border: none !important;
    }

    .btn-danger {
        background-color: #ef4444 !important;
        border: none !important;
    }

    .btn-outline-warning {
        color: #d97706 !important;
        border: 1.5px solid #f59e0b !important;
        background: transparent !important;
    }

        .btn-outline-warning:hover {
            background: #fef3c7 !important;
        }

    .table-responsive-custom {
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    table {
        margin-bottom: 0 !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
    }

    thead {
        background: #0f172a !important;
    }

    th {
        color: #f8fafc !important;
        font-weight: 600 !important;
        font-size: 0.85rem !important;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 18px 20px !important;
        border: none !important;
    }

    td {
        padding: 18px 20px !important;
        background-color: #ffffff;
        border-bottom: 1px solid #f1f5f9 !important;
        vertical-align: middle !important;
        color: #334155;
    }

    tr:last-child td {
        border-bottom: none !important;
    }

    tr:hover td {
        background-color: #f8fafc !important;
    }

    .ciphertext-container {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 6px 12px;
        color: #64748b;
        font-size: 0.85rem;
        max-width: 260px;
        display: inline-block;
    }

    .custom-badge {
        background: #f1f5f9 !important;
        color: #334155 !important;
        font-weight: 600 !important;
        padding: 10px 20px !important;
        border-radius: 12px !important;
        border: 1px solid #e2e8f0 !important;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .alert {
        border-radius: 16px !important;
        border: none !important;
        font-weight: 500 !important;
        padding: 16px 24px !important;
    }
</style>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 card flex-row py-3">
        <h2 class="mb-0 fs-3 d-flex align-items-center gap-3">
            <i class="fa-solid fa-shield-halved text-primary fs-2"></i>
            Hệ thống quản lý bệnh án an toàn
        </h2>
        <div class="d-flex align-items-center gap-2">
            <span class="custom-badge">
                <i class="fa-solid fa-circle-user text-primary fs-5"></i>
                Xin chào: <strong class="text-dark">@ViewBag.Username</strong> <span class="text-muted">(@ViewBag.Role)</span>
            </span>
            <a href="/Auth/Logout" class="btn btn-danger btn-sm px-3 py-2">
                <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm d-flex align-items-center mb-4" style="background-color: #ecfdf5; color: #065f46;">
            <i class="fa-solid fa-circle-check fs-4 me-3" style="color: #10b981;"></i>
            <div class="fw-semibold">@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm d-flex align-items-center mb-4 border-start border-danger border-4" style="background-color: #fff5f5; color: #e53e3e;">
            <i class="fa-solid fa-triangle-exclamation fs-3 text-danger me-3"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1" style="color: #c53030;">CẢNH BÁO BẢO MẬT HỆ THỐNG</h5>
                <p class="mb-0 fw-semibold" style="font-size: 0.95rem;">@TempData["Error"]</p>
            </div>
        </div>
    }

    @if (ViewBag.Role == "BacSi")
    {
        <div class="card mb-4">
            <h4 class="mb-4 text-primary fs-5 d-flex align-items-center gap-2">
                <i class="fa-solid fa-user-md"></i> [Quyền Bác sĩ] Thêm & Mã hóa bệnh án mới
            </h4>
            <form action="/Medical/CreateRecord" method="post">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <input type="text" name="patientName" class="form-control" placeholder="👤 Tên bệnh nhân" required />
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="plainTextContent" class="form-control" placeholder="📝 Nội dung bệnh án mật..." required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100 py-3">
                            <i class="fa-solid fa-lock-encrypted"></i> Mã hóa & Lưu dữ liệu
                        </button>
                    </div>
                </div>
            </form>
        </div>
    }

    @if (ViewBag.Role == "Auditor")
    {
        <div class="mb-4">
            <a href="/Medical/ViewLogs" class="btn btn-warning fw-bold shadow-sm w-100 py-3 fs-5">
                <i class="fa-solid fa-magnifying-glass-chart"></i> Truy cập trang xem Log kiểm toán (Auditor)
            </a>
        </div>
    }

    <div class="card">
        <h4 class="mb-4 fs-5 d-flex align-items-center gap-2">
            <i class="fa-solid fa-server text-secondary"></i> Danh sách bệnh án mã hóa trong Database
        </h4>
        <div class="table-responsive-custom">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="width: 80px; text-align: center;">ID</th>
                        <th style="width: 220px;">Tên Bệnh Nhân</th>
                        <th>Dữ liệu đã mã hóa (Ciphertext)</th>
                        <th style="width: 380px; text-align: center;">Hành động bảo mật</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary text-center">#@item.RecordID</td>
                            <td class="fw-bold text-dark">@item.PatientName</td>
                            <td>
                                <div class="ciphertext-container text-truncate">
                                    @if (item.Ciphertext != null)
                                    {
                                        @Convert.ToBase64String(item.Ciphertext)
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="d-flex gap-2 justify-content-center">
                                    <form action="/Medical/DecryptRecord" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.RecordID" />
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="fa-solid fa-key"></i> Giải mã
                                        </button>
                                    </form>

                                    @if (ViewBag.Role == "BacSi")
                                    {
                                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editModal-@item.RecordID">
                                            <i class="fa-solid fa-pen-to-square"></i> Sửa BA
                                        </button>
                                    }

                                    @if (ViewBag.Role != "BacSi")
                                    {
                                        <form action="/Medical/AttackRecord" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@item.RecordID" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm">
                                                <i class="fa-solid fa-triangle-exclamation"></i> Giả lập sửa
                                            </button>
                                        </form>
                                    }
                                </div>

                                @if (TempData["DecryptedText_" + item.RecordID] != null)
                                {
                                    <div id="decryptAlert-@item.RecordID" class="alert alert-warning mt-3 mb-0 p-3 shadow-sm border-start border-warning border-4 d-flex justify-content-between align-items-center" style="background-color: #fffbeb; color: #92400e; display: flex !important;">
                                        <div style="text-align: left; flex-grow: 1; padding-right: 15px;">
                                            <strong><i class="fa-solid fa-comment-medical me-1"></i> Nội dung gốc:</strong> @TempData["DecryptedText_" + item.RecordID]
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-warning px-2 py-1 d-flex align-items-center gap-1" style="border-radius: 8px !important; min-width: 65px;" onclick="document.getElementById('decryptAlert-@item.RecordID').style.setProperty('display', 'none', 'important')">
                                            <i class="fa-solid fa-eye-slash"></i> Ẩn
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@foreach (var item in Model)
{
    @if (ViewBag.Role == "BacSi")
    {
        <div class="modal fade" id="editModal-@item.RecordID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
                    <div class="modal-header bg-primary text-white py-3" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
                        <h5 class="modal-title fw-bold text-white fs-6"><i class="fa-solid fa-user-pen me-2"></i>Cập nhật bệnh án #@item.RecordID</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="/Medical/UpdateRecord" method="post">
                        <div class="modal-body p-4">
                            <input type="hidden" name="recordId" value="@item.RecordID" />

                            <div class="mb-3">
                                <label class="form-label fw-bold text-muted small text-uppercase">Tên bệnh nhân</label>
                                <input type="text" class="form-control bg-light fw-semibold" value="@item.PatientName" readonly style="border-color: #e2e8f0 !important;" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-primary small text-uppercase">Nội dung bệnh án mới</label>
                                <textarea name="newPlainTextContent" class="form-control" rows="3" placeholder="Nhập chẩn đoán lâm sàng hoặc đơn thuốc mới tại đây..." required></textarea>
                            </div>

                            <div class="p-3 border border-danger rounded-3" style="background-color: #fef2f2;">
                                <label class="form-label fw-bold text-danger small text-uppercase mb-1">
                                    <i class="fa-solid fa-shield-halved"></i> Xác thực mã an toàn cấp 2
                                </label>
                                <input type="password" name="dateToken" class="form-control" style="border: 1.5px solid #ef4444 !important; background-color: #fff;" placeholder="Nhập mã xác thực..." required />
                                <div class="form-text text-muted mt-1" style="font-size: 0.8rem; color: #991b1b !important;">
                                    <i class="fa-solid fa-circle-info"></i> Yêu cầu nhập đúng mã xác thực để thay đổi bệnh án.
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer py-3" style="background: #f8fafc; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; border-top: 1px solid #e2e8f0;">
                            <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-sm btn-primary"><i class="fa-solid fa-shield-halved"></i>Mã hóa & Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}