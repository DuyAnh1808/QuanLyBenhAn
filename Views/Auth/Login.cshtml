@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.6) 0%, rgba(30, 41, 59, 0.4) 100%), url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
            background-size: cover;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.65) !important;
            backdrop-filter: blur(16px) !important;
            -webkit-backdrop-filter: blur(16px) !important;
            border: 1px solid rgba(255, 255, 255, 0.4) !important;
            border-radius: 24px;
            box-shadow: 0 20px 40px -5px rgba(0, 0, 0, 0.07), 0 10px 10px -5px rgba(0, 0, 0, 0.03) !important;
            padding: 40px;
            width: 100%;
            max-width: 440px;
            transition: all 0.3s ease;
        }

        .login-title {
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
            font-size: 1.6rem;
            margin-bottom: 8px;
            text-align: center;
        }

        .login-subtitle {
            font-weight: 600;
            color: #2563eb;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 35px;
            text-align: center;
        }

        .form-group-custom {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            margin-bottom: 20px;
        }

        .form-label {
            font-weight: 700;
            color: #475569;
            font-size: 0.85rem;
            margin-bottom: 8px;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control {
            border-radius: 12px;
            border: 1.5px solid #cbd5e1;
            padding: 14px 16px;
            font-size: 0.95rem;
            background-color: rgba(248, 250, 252, 0.7) !important;
            color: #1e293b;
            transition: all 0.2s ease;
            width: 100%;
            max-width: 340px;
            text-align: center;
        }

            .form-control:focus {
                background-color: #ffffff !important;
                border-color: #2563eb;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
            }

        .btn-submit {
            background-color: #2563eb;
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            padding: 14px;
            width: 100%;
            max-width: 340px;
            font-size: 1rem;
            transition: all 0.2s ease;
            margin: 15px auto 0 auto;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-submit:hover {
                background-color: #1d4ed8;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
            }

            .btn-submit:active {
                transform: translateY(0);
            }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="login-title">HỆ THỐNG BỆNH ÁN</div>
        <div class="login-subtitle"><i class="fa-solid fa-shield-rsa me-1"></i> Xác thực đa yếu tố (MFA)</div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger p-3 mb-4 border-0 rounded-3 text-danger small fw-semibold text-center" style="background-color: rgba(255, 245, 245, 0.8);">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["Error"]
            </div>
        }

        <form action="/Auth/Login" method="post" class="d-flex flex-column align-items-center">

            <div class="form-group-custom">
                <label class="form-label">Tài khoản</label>
                <input type="text" name="username" class="form-control" placeholder="Nhập tên tài khoản" required autofocus />
            </div>

            <div class="form-group-custom">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="password" class="form-control" placeholder="••••••" required />
            </div>

            <button type="submit" class="btn btn-submit">
                Tiếp tục <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>
    </div>

</body>
</html>